# -----------------------------------------------------------------------------
# Frontend (Vite). These two values are PUBLIC by design — the anon key only
# grants what Row Level Security allows. Never put the service-role key here.
# Supabase dashboard → Project Settings → API.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`, NOT in
# this file and NOT in the frontend. Listed here for reference only.
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
# -----------------------------------------------------------------------------
# CRON_SECRET=generate-a-long-random-string
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="Nth Play <bookings@your-domain.com>"
# APP_URL=https://your-app-domain.com
# PAYMENT_WEBHOOK_SECRET=from-your-payment-provider
# PAYMENT_PROVIDER_NAME=gateway
